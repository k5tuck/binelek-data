{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  
  "EmbeddingService": {
    "Provider": "ollama",
    
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "nomic-embed-text",
      "Dimension": 768,
      "TimeoutSeconds": 30,
      "BatchSize": 10
    }
  }
}
