# Server Configuration
API_HOST=0.0.0.0
API_PORT=8097
ENVIRONMENT=development

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=binelek_pipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Elasticsearch (optional - for full-text search)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# JWT Authentication (must match binah-auth)
JWT_SECRET=your-super-secret-key-change-this-in-production-at-least-32-characters-long
JWT_ISSUER=Binah.Auth
JWT_AUDIENCE=Binah.Platform
JWT_ALGORITHM=HS256
AUTHENTICATION_ENABLED=true

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Tenant Isolation
ENABLE_TENANT_ISOLATION=true

# Search Configuration
MAX_RESULTS=100
DEFAULT_LIMIT=20

# Logging
LOG_LEVEL=INFO
